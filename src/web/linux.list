# The browser host's Linux root archive (design/linux-personality.md,
# design/hcpu.md): the paths, relative to the arm64 Alpine root
# that `scripts/fetch.sh alpinearm64web` makes, that `zig build web` packs into
# zig-out/web/linux.h9a for the demo page's ?linux mode. A path ending in
# / is an empty directory. tools/webroot.zig copies files rather than
# links, so busybox's applets are made by the page at start.

# Mount points the Linux view binds over, and where busybox --install
# puts its links.
dev/
proc/
sys/
tmp/
9/
mnt/term/cwd/
root/
sbin/
usr/sbin/

etc/os-release
etc/passwd
etc/group

# musl and busybox.
lib/ld-musl-aarch64.so.1
lib/libc.musl-aarch64.so.1
bin/busybox

# jq.
usr/bin/jq
usr/lib/libjq.so.1
usr/lib/libonig.so.5

# sqlite3.
usr/bin/sqlite3
usr/lib/libreadline.so.8
usr/lib/libncursesw.so.6
