#!/usr/bin/env -S node --disable-warning=ExperimentalWarning
// h9 on the web host's build, under Node 24 or later (JSPI on by default):
// the same flags as the native h9, on h9's own 386 CPU (h86). The host
// file system is WASI's, preopened at /. design/epoch-0/browser-host.md.

import fs from 'node:fs';
import { spawn } from 'node:child_process';
import { WASI } from 'node:wasi';
import { pathToFileURL } from 'node:url';
import { resolve } from 'node:path';
import { run, haveJSPI, Panic, Ports } from './h9-web.js';

const dir = new URL('.', import.meta.url);
if (!haveJSPI) {
  console.error('h9: this Node lacks JavaScript Promise Integration (Node 24 or later has it)');
  process.exit(125);
}

// Console input, one read per request, as the native console reader does.
const stdin = process.stdin;
let chunks = [], ended = false, waiting = null;
const deliver = () => {
  if (!waiting) return;
  const w = waiting;
  if (chunks.length) {
    let c = chunks.shift();
    if (c.length > w.n) { chunks.unshift(c.subarray(w.n)); c = c.subarray(0, w.n); }
    waiting = null;
    stdin.pause();
    w.res(c);
  } else if (ended) {
    waiting = null;
    w.res(null);
  }
};
stdin.on('data', (b) => { chunks.push(new Uint8Array(b)); deliver(); });
stdin.on('end', () => { ended = true; deliver(); });
stdin.on('error', () => { ended = true; deliver(); });
stdin.pause();

// Signals: Ctrl-C posts interrupt; SIGHUP and SIGTERM post hangup (2 and
// 3, so the exit status can name the signal).
const sigq = [];
let sigwait = null;
const raise = (n) => { if (sigwait) { const r = sigwait; sigwait = null; r(n); } else sigq.push(n); };
process.on('SIGINT', () => raise(1));
process.on('SIGHUP', () => raise(2));
process.on('SIGTERM', () => raise(3));

const host = {
  readStdin: (n) => new Promise((res) => {
    waiting = { n, res };
    if (!chunks.length && !ended) stdin.resume();
    deliver();
  }),
  cancelStdin: () => { if (waiting) { const w = waiting; waiting = null; stdin.pause(); w.res('cancelled'); } },
  waitSignal: () => sigq.length ? sigq.shift() : new Promise((res) => { sigwait = res; }),
  stopSignals: () => raise(0),
  setRaw: (on) => { if (stdin.isTTY) stdin.setRawMode(on); },
};

// --cred helpers (design/epoch-0/credential-helpers.md): Node runs the helper the
// native h9 would, as `argv... get URL`, with why the last try failed on
// stdin for a retry, and its stderr passed through. A browser's WebSocket
// only says that a handshake failed, so that's all a retry's stdin has.
const credentials = (url, failed, helper) => !helper ? null : new Promise((resolve, reject) => {
  const name = helper[0].split('/').pop();
  let p;
  try {
    p = spawn(helper[0], [...helper.slice(1), 'get', url], { stdio: ['pipe', 'pipe', 'pipe'] });
  } catch (e) {
    return reject(new Error(`credential helper ${name}: ${e.message}`));
  }
  const out = [], err = [];
  const timer = setTimeout(() => { p.kill('SIGKILL'); reject(new Error(`credential helper ${name}: no answer in 30 seconds`)); }, 30_000);
  p.stdout.on('data', (b) => out.push(b));
  p.stderr.on('data', (b) => { err.push(b); process.stderr.write(b); });
  p.on('error', (e) => { clearTimeout(timer); reject(new Error(`credential helper ${name}: ${e.code === 'ENOENT' ? 'not found' : e.message}`)); });
  p.on('close', (code, sig) => {
    clearTimeout(timer);
    const first = Buffer.concat(err).toString().split('\n').map((l) => l.trim()).find((l) => l);
    if (sig) return reject(new Error(`credential helper ${name}: killed by signal ${sig}`));
    if (code !== 0) return reject(new Error(`credential helper ${name}: ${first ?? `exit status ${code}`}`));
    const text = Buffer.concat(out).toString();
    out.forEach((b) => b.fill(0));
    // Up to a blank line, as the native h9 reads it.
    const lines = [];
    for (const l of text.split('\n')) { if (!l.trim()) break; lines.push(l); }
    resolve(lines);
  });
  p.stdin.on('error', () => {});
  p.stdin.end(failed ? `${failed}\n` : '');
});

// Ports (design/epoch-0/port-streams.md): H9_NODE_PORTS names an ES module whose
// default export is called with the machine's Ports before it starts, to
// add ports by name (ports.add), set ports.serving and ports.serveNet and
// hand it ports to serve (ports.serve), from worker_threads' MessageChannels.
// It may return a function, called once the machine ends. The integration
// cases' is tests/web/ports.mjs.
const ports = new Ports();
let portsDone = null;
if (process.env.H9_NODE_PORTS) {
  try {
    const mod = await import(pathToFileURL(resolve(process.env.H9_NODE_PORTS)).href);
    portsDone = (await mod.default(ports)) ?? null;
  } catch (e) {
    console.error(`h9: H9_NODE_PORTS: ${e?.message ?? e}`);
    process.exit(125);
  }
}

const env = { ...process.env, PWD: process.cwd() };
const wasi = new WASI({
  version: 'preview1',
  args: ['h9', ...process.argv.slice(2)],
  env,
  preopens: { '/': '/' },
  returnOnExit: true,
});
let code;
try {
  code = await run({
    h9: fs.readFileSync(new URL('h9.wasm', dir)),
    wasi: (memory) => {
      const imports = wasi.getImportObject().wasi_snapshot_preview1;
      // WASI needs the memory, which h9 imports rather than exports.
      wasi.initialize({ exports: { memory } });
      // Called through a JS function each: wasm calling Node's WASI
      // functions directly takes V8's fast API path, which crashes Node
      // on a JSPI coroutine's stack (it must run on the central stack).
      // The i32s are made unsigned on the way: wasm passes them signed,
      // and Node's WASI rejects a pointer past 2 GiB as negative.
      const out = {};
      for (const [k, f] of Object.entries(imports)) out[k] = (...a) => f(...a.map((x) => typeof x === 'number' ? x >>> 0 : x));
      return out;
    },
    host,
    credentials,
    ports,
    // The integration suite's stack depths, for the default stack size.
    stats: process.env.H9_TEST_STACK_LOG ? ({ maxStack }) => fs.appendFileSync(process.env.H9_TEST_STACK_LOG, `${maxStack}\n`) : undefined,
  });
} catch (e) {
  console.error(e instanceof Panic ? `h9: panic: ${e.message}` : e);
  code = 125;
}
try { await portsDone?.(); } catch {}
if (stdin.isTTY) stdin.setRawMode(false);
// Ends by letting the event loop run out rather than by process.exit,
// which can deadlock in V8 when a background compile is waiting for a GC
// as the process exits. Whatever still holds the loop open, such as a
// parked coroutine's timer, gets a moment and is then cut off.
process.exitCode = code;
stdin.destroy();
setTimeout(() => process.exit(code), 1000).unref();
