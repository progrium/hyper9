#!/bin/rc
# gencmds W: prints cmds.h for 9box.c from the commands mkcmd built in W,
# in the order of W/set: a declaration of each command's renamed main,
# threadmain and mainstacksize, and the table of them.
rfork e
w=$1
names=`{awk '{print $1}' $w/set}
fn has { grep -s '^'$2'$' $w/$1/main >[2]/dev/null }
echo '/* Generated by gencmds from the set; see 9box.c. */'
threads=0
for(c in $names){
	if(has $c main)
		echo 'extern void bx_'$c'_main(int, char**);'
	if(has $c threadmain){
		echo 'extern void bx_'$c'_threadmain(int, char**);'
		threads=1
	}
	if(has $c mainstacksize)
		echo 'extern int bx_'$c'_mainstacksize;'
}
if(~ $threads 1)
	echo '#define THREADS'
echo 'static Cmd cmds[] = {'
for(c in $names){
	m=nil
	t=nil
	s=nil
	if(has $c main)
		m=bx_$c^_main
	if(has $c threadmain)
		t=bx_$c^_threadmain
	if(has $c mainstacksize)
		s='&bx_'$c'_mainstacksize'
	if(~ $m nil && ~ $t nil){
		echo gencmds: $c has neither main nor threadmain >[1=2]
		exit nomain
	}
	echo '	{"'$c'", '$m', '$t', '$s'},'
}
echo '};'
