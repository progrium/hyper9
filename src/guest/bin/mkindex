#!/bin/rc
# mkindex [-o file] [-s spec] [dir]: writes the metadata index of the
# tree at dir, / by default, to standard output or file
# (design/mount-index.md). For /, it walks the root's own connection,
# /srv/root, attached with spec, so the paths bound over the root are
# left out. Names the format can't hold are left out and their
# directories marked !unindexed.
rfork en
fn usage { echo 'usage: mkindex [-o file] [-s spec] [dir]' >[1=2]; exit usage }
out=()
spec=()
while(~ $1 -*){
	switch($1){
	case -o
		~ $#* 1 && usage
		out=$2
		shift
	case -s
		~ $#* 1 && usage
		spec=$2
		shift
	case *
		usage
	}
	shift
}
~ $#* 0 1 || usage
dir=/
~ $#* 1 && dir=$1
~ $dir /* || dir=`{pwd}^/$dir

fn build {
	# walk cleans the name; it prints the directory itself with -n 0.
	ifs='
'	pre=`{walk -d -n 0 -e p $dir}
	~ $#pre 1 || exit walk
	if(~ $pre /){
		test -e /srv/root || {
			echo 'mkindex: no /srv/root: give the directory a mount is at' >[1=2]
			exit 'no /srv/root'
		}
		mount /srv/root /tmp $spec || exit mount
		pre=/tmp
	}
	echo h9index 1
	walk -e qxsmUGp $pre >[2=1] | pre=$pre awk -F '[ ]' '
	function hex(s,  i, n) {
		n = 0
		for(i = 1; i <= length(s); i++)
			n = n*16 + index("0123456789abcdef", substr(s, i, 1)) - 1
		return n
	}
	function oct(x,  s) {
		s = ""
		do {
			s = (x % 8) s
			x = int(x / 8)
		} while(x > 0)
		return "0" s
	}
	function bit(x, b) { return int(x / b) % 2 }
	# The path under the tree, or "" for one outside it.
	function rel(p,  n) {
		if(pre == "/")
			return p
		if(p == pre)
			return "/"
		n = length(pre)
		if(substr(p, 1, n + 1) == pre "/")
			return substr(p, n + 1)
		return ""
	}
	function parent(p,  i) {
		for(i = length(p); i > 1 && substr(p, i, 1) != "/"; i--)
			;
		return i <= 1 ? "/" : substr(p, 1, i - 1)
	}
	# Marks p, or else its nearest ancestor, for !unindexed.
	function mark(p) { marks[p] = 1 }
	# A name the format can hold: no space, control, or U+FFFD, which
	# stands for a byte that is not UTF-8.
	function goodname(s) { return s !~ /[ \001-\037\177�]/ }
	function record(  q, m, perm, i, c, mode, type, path, s, r, n, e, ok) {
		if(NF < 7 || $1 !~ /^[0-9a-f]+\.[0-9]+\.[0-9a-f][0-9a-f]$/)
			return 0
		m = $2
		if(m !~ /^[-daA][-l][-r][-w][-x][-r][-w][-x][-r][-w][-x]$/ || $3 !~ /^[0-9]+$/ || $4 !~ /^[0-9]+$/)
			return 0
		s = $0
		for(i = 0; i < 6; i++)
			s = substr(s, index(s, " ") + 1)
		r = rel(s)
		if(r == "")
			return 0
		split($1, q, ".")
		mode = 0
		c = substr(m, 1, 1)
		if(c == "d") mode += 2147483648
		if(c == "a") mode += 1073741824
		if(c == "A") mode += 134217728
		if(substr(m, 2, 1) == "l") mode += 536870912
		if(bit(hex(q[3]), 4)) mode += 67108864
		perm = 256
		for(i = 3; i <= 11; i++) {
			if(substr(m, i, 1) != "-") mode += perm
			perm /= 2
		}
		type = bit(mode, 2147483648) ? "d" : bit(mode, 1073741824) ? "a" : bit(mode, 536870912) ? "l" : "-"
		while(length(q[1]) < 16)
			q[1] = "0" q[1]
		# The first name it can not hold, if any.
		ok = 1
		n = 0
		i = 1
		s = ""
		if(r != "/") {
			n = split(substr(r, 2), e, "/")
			s = ""
			for(i = 1; i <= n; i++) {
				if(!goodname(e[i])) {
					ok = 0
					break
				}
				s = s "/" e[i]
			}
		}
		if($5 == "" || $6 == "")
			ok = 0
		cur = r
		curok = ok
		# A bad name marks its directory, and an empty owner the parent.
		curbad = i <= n ? (s == "" ? "/" : s) : parent(r)
		curline = r " " q[1] " " q[2] " " type " " oct(mode) " " $3 " " $4 " " $5 " " $6
		curdir = type == "d"
		return 1
	}
	function flush() {
		if(have) {
			if(prevok && prev != "/.h9index") {
				line[prev] = prevline
				if(prevdir)
					isdir[prev] = 1
			} else if(!prevok)
				mark(prevbad)
		}
		have = 0
	}
	# A warning: walk could not open or read a directory, which marks
	# it, or its parent when it is not in the index. Returns whether it
	# names a path in the tree.
	function warning(s,  i, p) {
		sub(/^walk: (couldn.t open |path: |\. or \.\. named file: )?/, "", s)
		if((i = index(s, ": ")) > 0)
			s = substr(s, 1, i - 1)
		p = rel(s)
		if(p != "")
			mark(p)
		return p != ""
	}
	BEGIN { pre = ENVIRON["pre"] }
	{
		if(record()) {
			flush()
			prev = cur
			prevok = curok
			prevbad = curbad
			prevline = curline
			prevdir = curdir
			have = 1
		} else if($0 ~ /^walk: / && warning($0)) {
			# A warning about a path in the tree.
		} else {
			# The rest of a name with a newline in it, so the record
			# before is not to be trusted.
			if(have)
				mark(parent(prev))
			have = 0
		}
	}
	END {
		flush()
		if(!("/" in isdir)) {
			print "mkindex: no root directory in the walk" >"/fd/2"
			exit 1
		}
		# An entry whose parent is missing is left out, and the
		# nearest directory above it marked.
		do {
			more = 0
			for(p in line)
				if(p != "/" && !(parent(p) in isdir)) {
					delete line[p]
					delete isdir[p]
					mark(parent(p))
					more = 1
				}
		} while(more)
		for(p in line)
			print line[p] | "sort"
		close("sort")
		for(p in marks) {
			while(p != "/" && !(p in isdir))
				p = parent(p)
			un[p] = 1
		}
		for(p in un)
			print "!unindexed " p | "sort"
		close("sort")
	}'
}

if(~ $#out 1)
	build >$out
if not
	build
