#!/bin/rc
# hcmd [-n] [-d dir] cmd [arg...]: run a command on the host through #C
#
# Needs h9 --host-cmd. Standard input, output and error are the host
# command's, and hcmd exits with its status: '' on success, its exit
# code ('3'), 'killed', or 'signal: N'. -d sets the host directory it
# runs in. Without it, the command runs in the host directory the
# guest's current directory comes from (/mnt/term/cwd is the host cwd)
# or, when that's not a host directory (/tmp, the root, an overlay),
# in h9's own host directory. -n gives the command an empty standard
# input. An interrupt or hangup kills the host command.
rfork e
fn usage { echo 'usage: hcmd [-n] [-d dir] cmd [arg...]' >[1=2]; exit usage }
dir=()
nostdin=()
while(~ $1 -*){
	switch($1){
	case -n
		nostdin=1
	case -d
		~ $#* 1 && usage
		dir=$2
		shift
	case --
		shift
		break
	case *
		usage
	}
	shift
}
~ $#* 0 && usage
if(! test -d '#C/cmd'){
	echo 'hcmd: host commands are off; run h9 with --host-cmd' >[1=2]
	exit 'host commands off'
}

# The host directory: -d, or the host path of the guest's directory,
# from the namespace's binds of #U (/proc/$pid/ns): the bind with the
# longest target holding the directory decides, so an overlay bound over
# part of a host tree hides it. Otherwise h9's own directory, '.'.
if(~ $#dir 0){
	dir=`{awk -v 'cwd='`{pwd} -f /fd/0 /proc/$pid/ns <<'EOF'
# tok: the next word of line, unquoted as rc quotes it.
function tok(	t, i, c) {
	sub(/^ +/, "", line)
	if(substr(line, 1, 1) != "'"){
		i = index(line, " ")
		if(i == 0){ t = line; line = "" }
		else { t = substr(line, 1, i-1); line = substr(line, i) }
		return t
	}
	t = ""
	for(i = 2; i <= length(line); i++){
		c = substr(line, i, 1)
		if(c == "'"){
			if(substr(line, i+1, 1) != "'"){ i++; break }
			i++
		}
		t = t c
	}
	line = substr(line, i)
	return t
}
$1 == "bind" {
	line = $0
	sub(/^bind +/, "", line)
	if(substr(line, 1, 1) == "-")
		tok()
	src = tok()
	tgt = tok()
	if(cwd != tgt && index(cwd, tgt "/") != 1 && tgt != "/")
		next
	u = substr(src, 1, 2) == "#U"
	if(length(tgt) < best || length(tgt) == best && !u)
		next
	best = length(tgt)
	host = ""
	if(u){
		rest = tgt == "/" ? cwd : substr(cwd, length(tgt)+1)
		host = substr(src, 3) rest
		if(host == "")
			host = "/"
	}
}
END { if(host != "") print host }
EOF
}
	~ $#dir 0 && dir=.
}

# Quote each argument for devcmd's ctl, which splits with tokenize(2):
# 'a b' stays one argument and '' is a quote.
fn quote {
	awk 'BEGIN{q="''"; for(i = 1; i < ARGC; i++){s = ARGV[i]; gsub(q, q q, s); printf " %s%s%s", q, s, q}}' $*
}

# The status is one message with no newline: pid, three times, then the
# quoted exit string.
fn exitstr {
	dd -bs 512 -count 1 -quiet 1 | sed -e 's/^[0-9]+ [0-9]+ [0-9]+ [0-9]+ //' -e 's/^''(.*)''$/\1/' -e 's/^exit: //' -e 's/''''/''/g'
}

<>[3]'#C/cmd/clone' {
	n=`{read <[0=3]}
	c='#C/cmd/'$n
	# Opened before exec: the exit status is kept only for an open wait.
	<[4]$c/wait {
		# One write per ctl message, so each line is built whole first.
		oifs=$ifs
		ifs=''
		qdir=`{quote $dir}
		qcmd=`{quote $*}
		ifs=$oifs
		{ echo killonclose && echo dir $qdir && echo exec $qcmd } >[1=3] || exit exec
		fn sigint sighup { echo kill >$c/ctl; exit interrupted }
		cat $c/stderr >[1=2] &
		errpid=$apid
		inpid=()
		if(~ $#nostdin 0){
			cat <[0=5] >$c/data >[2]/dev/null &
			inpid=$apid
		}
		if not
			cat /dev/null >$c/data
		# The readers run in the background and rc waits for them with
		# its wait builtin, which a note interrupts. A process reading a
		# host pipe can't be interrupted, so rc's handler must run while
		# they're still blocked: it kills the host command, which ends
		# its pipes and so the readers.
		cat $c/data &
		outpid=$apid
		wait $outpid
		wait $errpid
		ifs='
'
		st=`{exitstr <[0=4]}
		ifs=$oifs
		if(! ~ $#inpid 0)
			test -e /proc/$inpid/note && echo kill >/proc/$inpid/note
		exit $"st
	}
} <[5=0]
