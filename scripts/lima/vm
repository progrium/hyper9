#!/usr/bin/env bash
# Lima VMs for testing h9's emu backend: linux, macos and windows (arm64)
# and linux-amd64 (emulated x86_64); and its KVM backend: linux-kvm (arm64,
# nested virtualization). Instances live in .local/lima (their
# LIMA_HOME).
#
#   scripts/lima/vm up <os>            create (first time), start and provision
#   scripts/lima/vm down <os>          stop it
#   scripts/lima/vm rm <os>            delete it
#   scripts/lima/vm status             list the VMs
#   scripts/lima/vm shell <os> [cmd]   ssh into it (cmd.exe on windows)
#   scripts/lima/vm push <os> file...  copy files into ~/h9 in the guest
#   scripts/lima/vm push-root <os> [-f] copy the 9front root tree into ~/h9/root
#   scripts/lima/vm test <os> [backend|integration]...
#                                      push zig-out/<os> and the root tree, then
#                                      run the backend and integration tests
#
# Env: WIN_ISO (Windows 11 Arm64 installer ISO); H9_TEST_PENDING and
# H9_TEST_SLOW are passed to the integration tests.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
# Lima's UNIX socket paths are limited to 104 characters, so keep this short.
export LIMA_HOME="$ROOT/.local/lima"
OSES=(linux linux-amd64 linux-kvm macos windows)

die() { echo "vm: $*" >&2; exit 1; }
log() { echo "vm: $*" >&2; }

check_os() {
	case "${1:-}" in linux|linux-amd64|linux-kvm|macos|windows) ;; *) die "unknown os '${1:-}' (want: ${OSES[*]})" ;; esac
}

field() { limactl list "$1" --format "{{.$2}}" 2>/dev/null || true; }
exists() { [[ -n "$(field "$1" Name)" ]]; }
running() { [[ "$(field "$1" Status)" == Running ]]; }
need_running() { running "$1" || die "$1 is not running (scripts/lima/vm up $1)"; }

ssh_() { local os=$1; shift; ssh -F "$LIMA_HOME/$os/ssh.config" "lima-$os" "$@"; }
scp_() { local os=$1; shift; scp -q -F "$LIMA_HOME/$os/ssh.config" "$@"; }

cmd_up() {
	local os=$1
	mkdir -p "$LIMA_HOME"
	if ! exists "$os"; then
		local set=()
		if [[ "$os" == windows ]]; then
			local iso="${WIN_ISO:-$HOME/Downloads/Win11_25H2_English_Arm64_v2.iso}"
			[[ -f "$iso" ]] || die "no ISO at $iso (set WIN_ISO)"
			set=(--set ".images[0].location=\"$iso\"")
			log "first boot runs the unattended Windows install (~15 min); watch the VM display"
		fi
		limactl create --tty=false --name "$os" ${set[@]+"${set[@]}"} "$HERE/$os.yaml"
	fi
	running "$os" || limactl start --tty=false --timeout 4h "$os"
	"provision_$os"
	log "$os ready"
}

provision_linux() { :; }
provision_linux-amd64() { :; }
# The guest user opens /dev/kvm through the kvm group.
provision_linux-kvm() { ssh_ linux-kvm 'sudo usermod -aG kvm "$USER"' </dev/null; }
provision_macos() { :; }

provision_windows() {
	scp_ windows "$HERE/provision.ps1" "lima-windows:provision.ps1" </dev/null
	ssh_ windows powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File provision.ps1 </dev/null
}

cmd_push() {
	local os=$1; shift
	[[ $# -gt 0 ]] || die "usage: scripts/lima/vm push <os> file..."
	need_running "$os"
	ssh_ "$os" mkdir h9 </dev/null >/dev/null 2>&1 || true
	scp_ "$os" "$@" "lima-$os:h9/" </dev/null
}

# The root tree from scripts/mkroot.py, streamed as one tar over ssh (it's
# ~250 MB in ~10k files, too many for scp). A stamp in the guest copy names
# the tree and its build time, so an unchanged tree isn't copied again.
cmd_push_root() {
	local os=$1 force=${2:-}
	local root="$ROOT/.local/9front/root"
	[[ -d "$root/arm64" ]] || die "no root tree at $root (run scripts/mkroot.py)"
	[[ -z "$force" || "$force" == -f ]] || die "usage: scripts/lima/vm push-root <os> [-f]"
	need_running "$os"
	local real; real="$(cd "$root" && pwd -P)"
	local stamp; stamp="$(basename "$real") $(stat -f %m "$real" 2>/dev/null || stat -c %Y "$real")"
	local have
	if [[ "$os" == windows ]]; then
		have="$(ssh_ "$os" type 'h9\root\.h9-root' 2>/dev/null </dev/null | tr -d '\r' | sed 's/ *$//' || true)"
	else
		have="$(ssh_ "$os" cat h9/root/.h9-root 2>/dev/null </dev/null || true)"
	fi
	if [[ -z "$force" && "$have" == "$stamp" ]]; then
		log "$os: h9/root is up to date ($stamp)"
		return
	fi
	log "$os: copying $(basename "$real") into h9/root"
	if [[ "$os" == windows ]]; then
		# NTFS can't hold rc's '"' and '""' scripts, and Windows tar decodes
		# names in the ANSI code page, so non-ASCII names (just troff's
		# charlib/☺) are mangled. Both are left out. Windows tar also rejects
		# the "./" entry, so the top-level entries are named instead.
		local skip=(--exclude '^rc/bin/"*')
		while IFS= read -r f; do skip+=(--exclude "^${f#./}\$"); done < <(cd "$real" && LC_ALL=C find . -name '*[^ -~]*')
		bsdtar -cf - --no-xattrs --no-mac-metadata --no-acls --no-fflags -C "$real" "${skip[@]}" $(ls -A "$real") |
			ssh_ "$os" '(if exist h9\root.tmp rmdir /s /q h9\root.tmp) & mkdir h9\root.tmp && tar -xf - -C h9\root.tmp'
		ssh_ "$os" "(echo $stamp)> h9\\root.tmp\\.h9-root && (if exist h9\\root rmdir /s /q h9\\root) & move h9\\root.tmp h9\\root >nul" </dev/null
	else
		bsdtar -cf - --no-xattrs --no-mac-metadata --no-acls --no-fflags -C "$real" . |
			ssh_ "$os" 'set -e; mkdir -p h9; rm -rf h9/root.tmp; mkdir h9/root.tmp; tar -xf - -C h9/root.tmp'
		ssh_ "$os" "set -e; echo '$stamp' > h9/root.tmp/.h9-root; rm -rf h9/root; mv h9/root.tmp h9/root" </dev/null
	fi
	log "$os: h9/root ready"
}

# Runs the tests built by `zig build install install-tests -Demu=unicorn
# --prefix zig-out/<os>` (plus -Dtarget, see README.md) in the guest, on
# the emulator, against h9/root. The test binaries get no terminal from
# ssh; the interactive cases make their own (tests/term.zig).
cmd_test() {
	local os=$1; shift
	local which=("$@")
	# The root tree is arm64 only, so x86_64 has no integration tests yet.
	if [[ ${#which[@]} -eq 0 ]]; then
		if [[ "$os" == linux-amd64 ]]; then which=(backend); else which=(backend integration); fi
	fi
	local bin="$ROOT/zig-out/$os/bin" exe=""
	[[ "$os" == windows ]] && exe=.exe
	local files=("$bin/h9$exe")
	for w in "${which[@]}"; do
		case "$w" in backend|integration) files+=("$bin/$w-tests$exe") ;; *) die "unknown test set '$w' (want: backend integration)" ;; esac
	done
	for f in "${files[@]}"; do [[ -f "$f" ]] || die "no $f (see scripts/lima/README.md, Tests)"; done
	cmd_push "$os" "${files[@]}"
	[[ " ${which[*]} " == *" integration "* ]] && cmd_push_root "$os"
	# Emulated x86_64 is about ten times slower than the others, and on
	# Windows each guest process takes about 0.4 s to start.
	local slow=${H9_TEST_SLOW:-1}
	if [[ -z "${H9_TEST_SLOW:-}" ]]; then
		case "$os" in linux-amd64) slow=10 ;; windows) slow=3 ;; esac
	fi
	local pend=${H9_TEST_PENDING:-} arch=${H9_TEST_ARCH:-}
	local status=0
	for w in "${which[@]}"; do
		log "$os: $w tests"
		if [[ "$os" == windows ]]; then
			local set="set H9_TEST_BIN=%USERPROFILE%\\h9\\h9.exe&& set H9_TEST_ROOT=%USERPROFILE%/h9/root&& set H9_TEST_BACKENDS=emu&& set H9_TEST_SLOW=$slow&&"
			[[ -n "$pend" ]] && set+=" set H9_TEST_PENDING=1&&"
			[[ -n "$arch" ]] && set+=" set H9_TEST_ARCH=$arch&&"
			ssh_ "$os" "$set cd h9 && $w-tests.exe" </dev/null || status=1
		else
			local backends=emu
			[[ "$os" == linux-kvm ]] && backends=kvm,emu
			local vars="H9_TEST_BIN=\$HOME/h9/h9 H9_TEST_ROOT=\$HOME/h9/root H9_TEST_BACKENDS=$backends H9_TEST_SLOW=$slow"
			[[ -n "$pend" ]] && vars+=" H9_TEST_PENDING=1"
			[[ -n "$arch" ]] && vars+=" H9_TEST_ARCH=$arch"
			ssh_ "$os" "cd h9 && env $vars ./$w-tests" </dev/null || status=1
		fi
	done
	return $status
}

[[ $# -gt 0 ]] || { sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
cmd=$1; shift
case "$cmd" in
	status) limactl list; exit ;;
	up|down|rm|shell|push|push-root|test) check_os "${1:-}"; os=$1; shift ;;
	*) die "unknown command '$cmd'" ;;
esac
case "$cmd" in
	up) cmd_up "$os" ;;
	down) limactl stop "$os" ;;
	rm) limactl delete --force "$os" ;;
	shell) need_running "$os"; if [[ $# -gt 0 ]]; then ssh_ "$os" "$@"; else ssh_ "$os" -t; fi ;;
	push) cmd_push "$os" "$@" ;;
	push-root) cmd_push_root "$os" "$@" ;;
	test) need_running "$os"; cmd_test "$os" "$@" ;;
esac
